# AI 党建学习平台 - 生产环境配置
# 复制为 server.env 后修改。含 #、空格或特殊字符的值请使用双引号。

# 公网入口：有域名时填域名；仅用 IP 临时访问可填 http://服务器公网IP
APP_DOMAIN=party-school.example.com

# MySQL 8.0 空数据库。用户名、密码中的特殊字符需要 URL 编码。
DATABASE_URL="mysql://party_school:CHANGE_ME_DB_PASSWORD@mysql.example.com:3306/party_school"

NODE_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
SERVER_PREFIX=/api
CORS_ORIGINS=

# GENERATE_ON_INSTALL 会在安装时自动替换为随机密钥。
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
ENCRYPT_KEY=CHANGE_ME_generate_a_random_64_hex_character_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 默认安装同机 Redis。使用云 Redis 时改为 false 并填写远端连接信息。
INSTALL_LOCAL_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# 上传文件放到独立数据目录，升级版本不会覆盖。
UPLOAD_DIR=/var/lib/ai-party-school/uploads

# 首次部署默认执行迁移和初始化数据；已有库请先阅读 README 的升级说明。
RUN_DATABASE_MIGRATION=true
RUN_SEED=true
SEED_ADMIN_PASSWORD=CHANGE_ME_set_a_unique_admin_password_at_least_12_characters
SEED_SECRETARY_PASSWORD=CHANGE_ME_set_a_unique_secretary_password_at_least_12_characters
SEED_MEMBER_PASSWORD=CHANGE_ME_set_a_unique_member_password_at_least_12_characters

# 默认安装 Caddy 并自动申请 HTTPS 证书。
INSTALL_CADDY=true

# AI 可暂时留空，不影响登录、学习、考试等非 AI 功能。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
