# 基于 AI 的数智党校学习系统 - 环境变量示例
# 说明：未配置 MySQL/Redis 时，服务端仍可启动用于前端联调（DB/Redis 调用降级为非致命告警）
# 复制为 .env 后按需修改

# ===== Server =====
# Database
DATABASE_URL="mysql://root:root@localhost:3306/party_school"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
# 独立用于加密数据库中的 AI API Key；生产环境使用 32+ 位随机字符串并持久保存
ENCRYPT_KEY=CHANGE_ME_generate_a_random_64_hex_character_key
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
SERVER_PORT=3000
SERVER_PREFIX="/api"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# 开发 seed 可不填；生产环境必须设置至少 12 位密码
SEED_ADMIN_PASSWORD=CHANGE_ME_set_a_unique_admin_password_at_least_12_characters
SEED_SECRETARY_PASSWORD=CHANGE_ME_set_a_unique_secretary_password_at_least_12_characters
SEED_MEMBER_PASSWORD=CHANGE_ME_set_a_unique_member_password_at_least_12_characters

# Upload
UPLOAD_DIR="uploads"
UPLOAD_MAX_SIZE="200MB"

# DeepSeek AI
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_CHAT_MODEL="deepseek-chat"
DEEPSEEK_REASONER_MODEL="deepseek-reasoner"

# ===== Admin (Vite) =====
VITE_ADMIN_API_BASE="http://localhost:3000/api"

# ===== Mobile (Vite) =====
VITE_MOBILE_API_BASE="http://localhost:3000/api"
