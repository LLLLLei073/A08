# ===== 本地开发环境变量模板（可移植）=====
# 复制为 .env 后按需修改：cp .env.example .env
# 本文件不含任何机器相关绝对路径，可在任意电脑使用。

# ----- 数据库 -----
# 本地开发用 SQLite，数据库文件自动创建在 packages/server/prisma/dev.db
# （相对路径，随项目走，换机器无需改动）
DATABASE_URL="file:./dev.db"

# 生产环境（MySQL）示例：
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/party_school"

# ----- Redis（可选，未安装则自动降级为内存模式）-----
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# ----- JWT 密钥（生产环境务必改成 32+ 位随机字符串）-----
JWT_SECRET=CHANGE_ME_generate_a_random_secret_at_least_32_characters
# 独立用于加密数据库中的 AI API Key；部署后请勿修改
ENCRYPT_KEY=CHANGE_ME_generate_a_random_64_hex_character_key
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ----- 服务器 -----
SERVER_PORT=3000
SERVER_PREFIX="/api"
# 跨域允许的源（本地开发填写前端 dev 地址，生产留空走同源）
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# 开发 seed 可不填；生产环境必须设置至少 12 位密码
SEED_ADMIN_PASSWORD=CHANGE_ME_set_a_unique_admin_password_at_least_12_characters
SEED_SECRETARY_PASSWORD=CHANGE_ME_set_a_unique_secretary_password_at_least_12_characters
SEED_MEMBER_PASSWORD=CHANGE_ME_set_a_unique_member_password_at_least_12_characters

# ----- 文件上传 -----
UPLOAD_DIR="uploads"
UPLOAD_MAX_SIZE="200MB"

# ----- DeepSeek AI（实际 key 在 https://platform.deepseek.com 申请）-----
# 未配置时 AI 接口返回错误，不影响其它功能
DEEPSEEK_API_KEY="sk-not-configured"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_CHAT_MODEL="deepseek-chat"
DEEPSEEK_REASONER_MODEL="deepseek-reasoner"
