{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "VITE_STATIC_HOST=vercel pnpm --filter @ai-party-school/mobile build",
  "outputDirectory": "packages/mobile/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
